{
  "name": "cotacoes-omie",
  "version": "0.1.0",
  "private": true,
  "description": "Central Oon criada pelo Workspace.",
  "type": "module",
  "scripts": {
    "ooncore:docs": "create-central-oon docs --sync",
    "ooncore:docs:check": "create-central-oon docs --check",
    "ooncore:conformance": "create-central-oon conformance",
    "platform:check": "npm run ooncore:docs:check && npm run ooncore:conformance",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --test"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@oondemand/create-central-oon": "0.4.26"
  }
}
